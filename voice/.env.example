# Voice worker — copy to voice/.env and fill in. (voice/.env is gitignored.)

# --- LiveKit (media server) — from https://cloud.livekit.io ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Provider keys ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=

# --- The HITL backend the voice tools call (start it with `make run`) ---
BACKEND_URL=http://localhost:8000

# --- TTS A/B switch: deepgram | sarvam ---
TTS_PROVIDER=deepgram

# --- STT: Deepgram Nova-3 ---
STT_MODEL=nova-3
STT_LANGUAGE=en-US
# Write spoken numbers as digits: "order four four seven one" -> "order 4471".
# Leave this on — a misheard digit is a refund against the WRONG order.
STT_NUMERALS=true
# Domain vocabulary to boost (comma-separated). Rare/product words are the ones a
# general STT model drops. Measure the gain with: python voice/bench_pipeline.py
STT_KEYTERMS=refund,order number,cancel,damaged,defective,store credit,shipping address,tracking,supervisor,ceramic dinner set,Bluetooth speaker,standing desk
# How long Deepgram waits on silence before finalising. Lower = snappier turns.
STT_ENDPOINTING_MS=25

# --- Turn taking ---
# vad      = end the turn on silence (default; always works)
# semantic = end the turn on MEANING — lower perceived latency, and it stops the
#            agent cutting people off when they pause to think. Runs on LiveKit's
#            inference service. Recommended once your LiveKit keys are in place;
#            falls back to vad automatically if unavailable.
TURN_DETECTION=vad

# --- LLM: Groq ---
GROQ_MODEL=llama-3.3-70b-versatile

# --- Deepgram Aura TTS (US English) ---
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

# --- Sarvam TTS (note: Sarvam English is Indian English, en-IN) ---
# Speaker must be compatible with the model. bulbul:v3 voices include:
# amelia, sophia, pooja, priya, neha, kavya, ritu, shreya ...
# (anushka/manisha/vidya are bulbul:v2 only)
SARVAM_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_SPEAKER=amelia

# --- Approval calls (the agent phones a human for sign-off) ---
# Spoken PIN the supervisor must say before a decision is recorded. Whoever answers
# the call could otherwise approve a refund. Leave empty ONLY in dev.
APPROVER_PIN=2468
# Must match the backend's APPROVER_AGENT_NAME (the dispatch address).
APPROVER_AGENT_NAME=approval-agent

# --- Latency tuning ---
MIN_ENDPOINTING_DELAY=0.4
MAX_ENDPOINTING_DELAY=3.0
PREEMPTIVE_GENERATION=true
