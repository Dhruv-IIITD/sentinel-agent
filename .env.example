# --- Reasoning model ---
# Which provider powers the agent: groq (free tier) or anthropic.
LLM_PROVIDER=groq

# Groq (free): get a key at https://console.groq.com/keys
GROQ_API_KEY=
# A tool-calling-capable model (required — the agent binds tools).
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (Claude) — only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MODEL=claude-opus-4-8

# low | medium | high | xhigh | max
EFFORT=high

# --- Database (checkpointer state + audit log + app data + RAG) ---
# e.g. postgresql://hitl:hitl@localhost:5432/hitl_agent
# Leave blank to run in dev mode (in-memory or sqlite checkpointer).
DATABASE_URL=

# --- Shared cross-worker state / approval events (optional) ---
# Leave blank for the in-process development/test fallback.
REDIS_URL=
VERIFICATION_TTL_SECONDS=1800
# Requests per client IP per minute. Zero keeps the limiter disabled.
RATE_LIMIT_PER_MINUTE=0
# Pending approval SLA. Zero disables escalation.
SLA_SECONDS=0
SLA_POLL_SECONDS=15

# --- Payments (mock-only until the Stripe provider lands) ---
PAYMENTS_PROVIDER=mock
# Stripe test-mode secret keys start with sk_test_. Never use a live key here.
STRIPE_API_KEY=

# --- Operator auth (disabled by default) ---
# Development values only. Change both before enabling auth in production.
AUTH_ENABLED=false
JWT_SECRET=dev-only-change-in-production-32bytes
DEMO_USER_PASSWORD=demo-password
JWT_EXPIRE_MINUTES=720
OPERATOR_APPROVAL_LIMIT=100

# --- Checkpointer backend ---
# auto -> postgres when DATABASE_URL is set, else in-memory.
# memory  -> in-process only (dev/tests).
# sqlite  -> a local file; survives process restarts without Postgres.
# postgres-> production; survives restarts.
CHECKPOINT_BACKEND=auto
SQLITE_PATH=data/checkpoints.sqlite

# --- Retrieval ---
# keyword -> lexical, no deps (default). vector -> embeddings + cosine
# (pgvector when a DB is set, else an in-memory vector index).
RETRIEVER=keyword
EMBEDDING_DIM=256

# --- Guardrails ---
HARD_REFUND_CAP=1000
CONFIDENCE_THRESHOLD=0.7

# --- LiveKit (voice) ---
# Needed for the browser console's "Start a voice call" button (it asks the
# backend to mint a join token). Same project as voice/.env.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Outbound approval calls. The LiveKit SIP bridge is free; a real phone number and
# PSTN minutes are not (Twilio/Telnyx). Leave the trunk blank and the approval call
# still works — in a browser room instead of over the phone.
LIVEKIT_SIP_TRUNK_ID=
APPROVER_PHONE=
APPROVER_AGENT_NAME=approval-agent

# --- Observability (LangSmith) ---
# Set tracing=true + an API key to trace every node, tool call, retrieval, and
# LLM call (with token/cost/latency) in the LangSmith UI.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=hitl-agent

# --- App ---
APP_ENV=development
